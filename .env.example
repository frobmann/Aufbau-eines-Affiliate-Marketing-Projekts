# Amazon Product Advertising API (PA-API 5.0) Zugangsdaten
# ---------------------------------------------------------
# Diese Datei nach ".env" kopieren und mit deinen echten Werten fuellen.
# .env ist in .gitignore und wird NICHT eingecheckt (Geheimnisse!).
#
# Voraussetzung: aktiver Amazon-Partner-Account + 3 qualifizierte Verkaeufe,
# danach unter https://partnernet.amazon.de -> Tools -> Product Advertising API
# die Schluessel erzeugen.

PAAPI_ACCESS_KEY=DEIN_ACCESS_KEY
PAAPI_SECRET_KEY=DEIN_SECRET_KEY

# Dein Partner-Tag (muss zum Marketplace passen), z. B. deinname-21 fuer amazon.de
PAAPI_PARTNER_TAG=DEIN-TAG-21

# Marketplace-Domain (amazon.de | amazon.com | amazon.co.uk | amazon.fr ...)
PAAPI_DOMAIN=amazon.de
